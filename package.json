{
  "name": "crdt-notes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "NUM_RUNS=10000 vitest run --silent=false",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "vitest run --config vitest.bench.config.ts --silent=false",
    "dev:server": "pnpm --filter @crdt-notes/server start",
    "dev:web": "pnpm --filter @crdt-notes/web dev",
    "e2e": "pnpm --filter @crdt-notes/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
